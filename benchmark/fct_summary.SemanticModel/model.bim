        ]
      },
      {
        "name": "stg_csv_archive_log",
        "description": "The download watermark: one row per CSV extracted into the landing lakehouse. What the pipeline has already ingested.",
        "sourceLineageTag": "[landing].[stg_csv_archive_log]",
        "columns": [
          {
            "name": "source_type",
            "dataType": "string",
            "sourceColumn": "source_type",
            "sourceLineageTag": "source_type",
            "summarizeBy": "none",
            "description": "Which AEMO source the file came from"
          },
          {
            "name": "source_filename",
            "dataType": "string",
            "sourceColumn": "source_filename",
            "sourceLineageTag": "source_filename",
            "summarizeBy": "none",
            "description": "Name of the downloaded archive"
          },
          {
            "name": "archive_path",
            "dataType": "string",
            "sourceColumn": "archive_path",
            "sourceLineageTag": "archive_path",
            "summarizeBy": "none",
            "description": "OneLake path the CSV was written to"
          },
          {
            "name": "archived_at",
            "dataType": "dateTime",
            "sourceColumn": "archived_at",
            "sourceLineageTag": "archived_at",
            "summarizeBy": "none",
            "description": "When the file was ingested",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "row_count",
            "dataType": "int64",
            "sourceColumn": "row_count",
            "sourceLineageTag": "row_count",
            "summarizeBy": "sum",
            "description": "Rows extracted from this file",
            "formatString": "#,##0"
          },
          {
            "name": "source_url",
            "dataType": "string",
            "sourceColumn": "source_url",
            "sourceLineageTag": "source_url",
            "summarizeBy": "none",
            "description": "URL the archive was fetched from"
          },
          {
            "name": "etag",
            "dataType": "string",
            "sourceColumn": "etag",
            "sourceLineageTag": "etag",
            "summarizeBy": "none",
            "description": "HTTP ETag of the fetched archive"
          },
          {
            "name": "csv_filename",
            "dataType": "string",
            "sourceColumn": "csv_filename",
            "sourceLineageTag": "csv_filename",
            "summarizeBy": "none",
            "description": "Name of the extracted CSV"
          }
        ],
        "measures": [
          {
            "name": "Archive Files",
            "description": "Files ingested",
            "expression": "COUNTROWS(stg_csv_archive_log)",
            "formatString": "#,##0"
          },
          {
            "name": "Archive Source Rows",
            "description": "Rows extracted across those files",
            "expression": "SUM(stg_csv_archive_log[row_count])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "stg_csv_archive_log",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "stg_csv_archive_log",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "fct_summary_to_dim_duid",
        "fromTable": "fct_summary",
        "fromColumn": "DUID",
        "toTable": "dim_duid",
        "toColumn": "DUID",
        "relyOnReferentialIntegrity": true
      },
      {
        "name": "fct_summary_to_dim_calendar",
        "fromTable": "fct_summary",
        "fromColumn": "date",
        "toTable": "dim_calendar",
        "toColumn": "date",
        "relyOnReferentialIntegrity": true
      },
      {
        "name": "fct_scada_to_dim_duid",
        "fromTable": "fct_scada",
        "fromColumn": "DUID",
        "toTable": "dim_duid",
        "toColumn": "DUID",
        "relyOnReferentialIntegrity": false
      },
      {
        "name": "fct_scada_to_dim_calendar",
        "fromTable": "fct_scada",
        "fromColumn": "DATE",
        "toTable": "dim_calendar",
        "toColumn": "date",
