          },
          {
            "name": "DATE",
            "dataType": "dateTime",
            "sourceColumn": "DATE",
            "sourceLineageTag": "DATE",
            "summarizeBy": "none",
            "description": "Dispatch date — foreign key to dim_calendar",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "YEAR",
            "dataType": "int64",
            "sourceColumn": "YEAR",
            "sourceLineageTag": "YEAR",
            "summarizeBy": "none",
            "description": "Dispatch year"
          },
          {
            "name": "INTERVENTION",
            "dataType": "double",
