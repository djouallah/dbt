{
  "compatibilityLevel": 1604,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"RemoteModeling\", \"DirectLakeOnOneLakeCreatedInDesktop\"]"
      }
    ],
    "expressions": [
      {
        "name": "DirectLake",
        "kind": "m",
        "description": "Direct Lake connection to OneLake — reads the Delta tables directly, no SQL endpoint. The two GUIDs are workspace + item and are REWRITTEN at deploy time by duckrun's workspace.deploy(lakehouse=...), which is how one template serves every lakehouse engine. The checked-in pair is the duckrun leg (dbt_delta).",
        "expression": [
          "let",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/ea575278-bd81-459c-9680-47829898c902/270c2534-3e66-4d37-b238-74da59d0d6d0\", [HierarchicalNavigation=true])",
          "in",
          "    Source"
        ]
      }
    ],
    "tables": [
      {
        "name": "dim_calendar",
        "description": "Calendar dimension covering 2018-04-01 to 2026-12-31.\nUsed to filter and aggregate electricity market data by date, month, and year.",
        "sourceLineageTag": "[mart].[dim_calendar]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "description": "Calendar date (primary key). One row per day.",
            "isKey": true,
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "sourceLineageTag": "year",
            "summarizeBy": "none",
            "description": "Calendar year (e.g. 2024)"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month",
            "sourceLineageTag": "month",
            "summarizeBy": "none",
            "description": "Calendar month number (1-12)"
          }
        ],
        "partitions": [
          {
            "name": "dim_calendar",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_calendar",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "dim_duid",
        "description": "Generator unit reference dimension for the Australian National Electricity Market (NEM).\nOne row per Dispatchable Unit Identifier (DUID) — a power station or generation unit.",
        "sourceLineageTag": "[mart].[dim_duid]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "description": "Dispatchable Unit Identifier (primary key)",
            "isKey": true
          },
          {
            "name": "Region",
            "dataType": "string",
            "sourceColumn": "Region",
            "sourceLineageTag": "Region",
            "summarizeBy": "none",
            "description": "NEM region code (NSW1, QLD1, VIC1, SA1, TAS1, WA1)"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State",
            "sourceLineageTag": "State",
            "summarizeBy": "none",
            "description": "Australian state name"
          },
          {
            "name": "FuelSourceDescriptor",
            "dataType": "string",
            "sourceColumn": "FuelSourceDescriptor",
            "sourceLineageTag": "FuelSourceDescriptor",
            "summarizeBy": "none",
            "description": "Fuel source type (Black coal, Natural gas, Solar, Wind)"
          },
          {
            "name": "Participant",
            "dataType": "string",
            "sourceColumn": "Participant",
            "sourceLineageTag": "Participant",
            "summarizeBy": "none",
            "description": "Market participant company name"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "sourceColumn": "latitude",
            "sourceLineageTag": "latitude",
            "summarizeBy": "none",
            "description": "Geographic latitude of the unit"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "sourceColumn": "longitude",
            "sourceLineageTag": "longitude",
            "summarizeBy": "none",
            "description": "Geographic longitude of the unit"
          }
        ],
        "partitions": [
          {
            "name": "dim_duid",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "dim_duid",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_summary",
        "description": "The mart fact: SCADA dispatch joined to price.\nGrain: one row per 5-minute dispatch interval per DUID. Daily history plus the intraday tail.",
        "sourceLineageTag": "[mart].[fct_summary]",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "sourceLineageTag": "date",
            "summarizeBy": "none",
            "description": "Dispatch date",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "time",
            "dataType": "int64",
            "sourceColumn": "time",
            "sourceLineageTag": "time",
            "summarizeBy": "none",
            "description": "Time of day as HHMM integer (1430 = 2:30 PM)"
          },
          {
            "name": "DUID",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "description": "Generator unit identifier — foreign key to dim_duid"
          },
          {
            "name": "mw",
            "dataType": "decimal",
            "sourceColumn": "mw",
            "sourceLineageTag": "mw",
            "summarizeBy": "sum",
            "description": "Power output in MW for this 5-minute interval",
            "formatString": "#,##0.00"
          },
          {
            "name": "price",
            "dataType": "decimal",
            "sourceColumn": "price",
            "sourceLineageTag": "price",
            "summarizeBy": "none",
            "description": "Regional reference price in AUD/MWh",
            "formatString": "$#,##0.00"
          },
          {
            "name": "cutoff",
            "dataType": "dateTime",
            "sourceColumn": "cutoff",
            "sourceLineageTag": "cutoff",
            "summarizeBy": "none",
            "description": "Timestamp of the latest data refresh cutoff",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "measures": [
          {
            "name": "Total MW",
            "description": "Total megawatts across the selection",
            "expression": "SUM(fct_summary[mw])",
            "formatString": "#,##0"
          },
          {
            "name": "Total MWh",
            "description": "Total megawatt-hours. MW/12 because each row is a 5-minute interval (60/5).",
            "expression": "SUM(fct_summary[mw]) / 12",
            "formatString": "#,##0"
          },
          {
            "name": "Avg Price",
            "description": "Average electricity price in AUD/MWh",
            "expression": "AVERAGE(fct_summary[price])",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Generator Count",
            "description": "Distinct generator units in the selection",
            "expression": "DISTINCTCOUNT(fct_summary[DUID])",
            "formatString": "#,##0"
          },
          {
            "name": "Latest Update",
            "description": "Most recent refresh cutoff, ignoring all filters",
            "expression": "CALCULATE(MAX(fct_summary[cutoff]), REMOVEFILTERS())",
            "formatString": "yyyy-MM-dd HH:mm"
          }
        ],
        "partitions": [
          {
            "name": "fct_summary",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_summary",
              "expressionSource": "DirectLake",
              "schemaName": "mart"
            }
          }
        ]
      },
      {
        "name": "fct_scada",
        "description": "Raw AEMO DISPATCH_UNIT_SOLUTION: per-unit dispatch, daily archive. The largest table in the project and the heaviest cold transcode in the benchmark.\nColumn subset — the source carries ~55 fields, mostly FCAS.",
        "sourceLineageTag": "[landing].[fct_scada]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "description": "Generator unit identifier"
          },
          {
            "name": "SETTLEMENTDATE",
            "dataType": "dateTime",
            "sourceColumn": "SETTLEMENTDATE",
            "sourceLineageTag": "SETTLEMENTDATE",
            "summarizeBy": "none",
            "description": "Dispatch interval timestamp",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "DATE",
            "dataType": "dateTime",
            "sourceColumn": "DATE",
            "sourceLineageTag": "DATE",
            "summarizeBy": "none",
            "description": "Dispatch date — foreign key to dim_calendar",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "YEAR",
            "dataType": "int64",
            "sourceColumn": "YEAR",
            "sourceLineageTag": "YEAR",
            "summarizeBy": "none",
            "description": "Dispatch year"
          },
          {
            "name": "INTERVENTION",
            "dataType": "double",
            "sourceColumn": "INTERVENTION",
            "sourceLineageTag": "INTERVENTION",
            "summarizeBy": "none",
            "description": "0 = the physical run; 1 = an intervention run"
          },
          {
            "name": "INITIALMW",
            "dataType": "double",
            "sourceColumn": "INITIALMW",
            "sourceLineageTag": "INITIALMW",
            "summarizeBy": "sum",
            "description": "Unit output at the start of the interval",
            "formatString": "#,##0.00"
          },
          {
            "name": "TOTALCLEARED",
            "dataType": "double",
            "sourceColumn": "TOTALCLEARED",
            "sourceLineageTag": "TOTALCLEARED",
            "summarizeBy": "sum",
            "description": "Target output for the interval",
            "formatString": "#,##0.00"
          },
          {
            "name": "AVAILABILITY",
            "dataType": "double",
            "sourceColumn": "AVAILABILITY",
            "sourceLineageTag": "AVAILABILITY",
            "summarizeBy": "sum",
            "description": "Available capacity for the interval",
            "formatString": "#,##0.00"
          },
          {
            "name": "file",
            "dataType": "string",
            "sourceColumn": "file",
            "sourceLineageTag": "file",
            "summarizeBy": "none",
            "description": "Source archive file — the incremental key"
          }
        ],
        "measures": [
          {
            "name": "Scada Rows",
            "description": "Row count of the raw dispatch fact",
            "expression": "COUNTROWS(fct_scada)",
            "formatString": "#,##0"
          },
          {
            "name": "Scada MW",
            "description": "Sum of raw unit output",
            "expression": "SUM(fct_scada[INITIALMW])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "fct_scada",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_scada",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      },
      {
        "name": "fct_price",
        "description": "Raw AEMO DISPATCHPRICE / regional summary: per-region price, daily archive.\nColumn subset — the source carries ~130 fields, almost all FCAS prices.",
        "sourceLineageTag": "[landing].[fct_price]",
        "columns": [
          {
            "name": "REGIONID",
            "dataType": "string",
            "sourceColumn": "REGIONID",
            "sourceLineageTag": "REGIONID",
            "summarizeBy": "none",
            "description": "NEM region code"
          },
          {
            "name": "SETTLEMENTDATE",
            "dataType": "dateTime",
            "sourceColumn": "SETTLEMENTDATE",
            "sourceLineageTag": "SETTLEMENTDATE",
            "summarizeBy": "none",
            "description": "Dispatch interval timestamp",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "DATE",
            "dataType": "dateTime",
            "sourceColumn": "DATE",
            "sourceLineageTag": "DATE",
            "summarizeBy": "none",
            "description": "Dispatch date — foreign key to dim_calendar",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "YEAR",
            "dataType": "int64",
            "sourceColumn": "YEAR",
            "sourceLineageTag": "YEAR",
            "summarizeBy": "none",
            "description": "Dispatch year"
          },
          {
            "name": "INTERVENTION",
            "dataType": "double",
            "sourceColumn": "INTERVENTION",
            "sourceLineageTag": "INTERVENTION",
            "summarizeBy": "none",
            "description": "0 = the physical run; 1 = an intervention run"
          },
          {
            "name": "RRP",
            "dataType": "double",
            "sourceColumn": "RRP",
            "sourceLineageTag": "RRP",
            "summarizeBy": "none",
            "description": "Regional reference price, AUD/MWh",
            "formatString": "$#,##0.00"
          },
          {
            "name": "ROP",
            "dataType": "double",
            "sourceColumn": "ROP",
            "sourceLineageTag": "ROP",
            "summarizeBy": "none",
            "description": "Regional original price, before any cap",
            "formatString": "$#,##0.00"
          },
          {
            "name": "TOTALDEMAND",
            "dataType": "double",
            "sourceColumn": "TOTALDEMAND",
            "sourceLineageTag": "TOTALDEMAND",
            "summarizeBy": "sum",
            "description": "Regional total demand, MW",
            "formatString": "#,##0.00"
          },
          {
            "name": "file",
            "dataType": "string",
            "sourceColumn": "file",
            "sourceLineageTag": "file",
            "summarizeBy": "none",
            "description": "Source archive file — the incremental key"
          }
        ],
        "measures": [
          {
            "name": "Price Rows",
            "description": "Row count of the raw price fact",
            "expression": "COUNTROWS(fct_price)",
            "formatString": "#,##0"
          },
          {
            "name": "Avg RRP",
            "description": "Average regional reference price",
            "expression": "AVERAGE(fct_price[RRP])",
            "formatString": "$#,##0.00"
          }
        ],
        "partitions": [
          {
            "name": "fct_price",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_price",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      },
      {
        "name": "fct_scada_today",
        "description": "Raw AEMO DISPATCH_UNIT_SCADA: the intraday tail beyond the daily archive horizon. Covers 406 DUIDs including 28 non-scheduled units that never appear in fct_scada.",
        "sourceLineageTag": "[landing].[fct_scada_today]",
        "columns": [
          {
            "name": "DUID",
            "dataType": "string",
            "sourceColumn": "DUID",
            "sourceLineageTag": "DUID",
            "summarizeBy": "none",
            "description": "Generator unit identifier"
          },
          {
            "name": "SETTLEMENTDATE",
            "dataType": "dateTime",
            "sourceColumn": "SETTLEMENTDATE",
            "sourceLineageTag": "SETTLEMENTDATE",
            "summarizeBy": "none",
            "description": "Dispatch interval timestamp",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "LASTCHANGED",
            "dataType": "dateTime",
            "sourceColumn": "LASTCHANGED",
            "sourceLineageTag": "LASTCHANGED",
            "summarizeBy": "none",
            "description": "When AEMO last revised this row",
            "formatString": "yyyy-MM-dd HH:mm"
          },
          {
            "name": "DATE",
            "dataType": "dateTime",
            "sourceColumn": "DATE",
            "sourceLineageTag": "DATE",
            "summarizeBy": "none",
            "description": "Dispatch date — foreign key to dim_calendar",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "YEAR",
            "dataType": "int64",
            "sourceColumn": "YEAR",
            "sourceLineageTag": "YEAR",
            "summarizeBy": "none",
            "description": "Dispatch year"
          },
          {
            "name": "INITIALMW",
            "dataType": "double",
            "sourceColumn": "INITIALMW",
            "sourceLineageTag": "INITIALMW",
            "summarizeBy": "sum",
            "description": "Unit output at the start of the interval",
            "formatString": "#,##0.00"
          },
          {
            "name": "file",
            "dataType": "string",
            "sourceColumn": "file",
            "sourceLineageTag": "file",
            "summarizeBy": "none",
            "description": "Source file — the incremental key"
          }
        ],
        "measures": [
          {
            "name": "Scada Today Rows",
            "description": "Row count of the intraday tail",
            "expression": "COUNTROWS(fct_scada_today)",
            "formatString": "#,##0"
          },
          {
            "name": "Scada Today MW",
            "description": "Sum of intraday unit output",
            "expression": "SUM(fct_scada_today[INITIALMW])",
            "formatString": "#,##0"
          }
        ],
        "partitions": [
          {
            "name": "fct_scada_today",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fct_scada_today",
              "expressionSource": "DirectLake",
              "schemaName": "landing"
            }
          }
        ]
      },
      {
